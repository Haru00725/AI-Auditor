# ==========================================
# AI Website Auditor - Environment Configuration
# ==========================================

# Groq API Key (Optional)
# Get a free API key at: https://console.groq.com/keys
# If left empty, the auditor will still work using built-in rule-based fallback pitches!
GROQ_API_KEY=your_groq_api_key_here

# Model to use on Groq (Optional, defaults to qwen/qwen3.8-27b)
# Options include:
# - qwen/qwen3.8-27b
# - llama-3.3-70b-versatile
# - llama-3.1-8b-instant
AI_MODEL=qwen/qwen3.8-27b
